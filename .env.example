# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgres://user:password@host:5432/dbname"

# ─── S3 (Beget Cloud / любой S3-совместимый) ──────────────────────────────────
AWS_REGION="ru1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Сгенерировать секрет: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Email единственного админа. Используется и Better Auth, и проверкой в layout.
ADMIN_EMAIL=""
# Пароль админа — нужен только для первого `pnpm db:seed`, дальше можно убрать.
ADMIN_PASSWORD=""

# ─── Уведомления о новых заказах ──────────────────────────────────────────────
# Telegram-бот (опционально, но рекомендуется)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# SMTP-настройки почтового провайдера.
# Reg.ru хостинг:      SMTP_HOST="mail.hosting.reg.ru"   SMTP_PORT="465" (SSL) или "587" (STARTTLS)
# Yandex 360:          SMTP_HOST="smtp.yandex.ru"        SMTP_PORT="465" (нужен пароль приложения)
# Mail.ru для бизнеса: SMTP_HOST="smtp.mail.ru"          SMTP_PORT="465"
#
# Если порт 465 не работает (блокируется антивирусом/провайдером —
# часто ETIMEDOUT), попробуйте 587 — код автоматически переключится
# на STARTTLS.
# SMTP_USER — полный email (info@example.com), не просто логин.
SMTP_HOST="mail.hosting.reg.ru"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# Куда слать письма о новых заказах админу. Если не задан — email админу не отправляется.
# Клиенту письмо-подтверждение уходит на тот email, что он указал в форме (SMTP_USER должен быть валиден).
NOTIFICATION_EMAIL=""

# ─── Публичные ────────────────────────────────────────────────────────────────
# Канонический адрес сайта. Используется для canonical-ссылок, sitemap.xml,
# OG-изображений, JSON-LD и ссылок «Открыть в админке» в письмах/Telegram.
# На проде задайте основной домен без www, напр. https://siblay.ru
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_YANDEX_METRIKA_ID=""
# Код подтверждения прав в Яндекс.Вебмастере (значение атрибута content
# из метатега yandex-verification). Можно оставить пустым.
NEXT_PUBLIC_YANDEX_VERIFICATION=""
