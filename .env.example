# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgres://user:password@host:5432/dbname"

# ─── S3 (Beget Cloud / любой S3-совместимый) ──────────────────────────────────
AWS_REGION="ru1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Сгенерировать секрет: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Email единственного админа. Используется и Better Auth, и проверкой в layout.
ADMIN_EMAIL=""
# Пароль админа — нужен только для первого `pnpm db:seed`, дальше можно убрать.
ADMIN_PASSWORD=""

# ─── Уведомления о новых заказах ──────────────────────────────────────────────
# Telegram-бот (опционально, но рекомендуется)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# SMTP (опционально). По умолчанию Yandex SMTP, порт 465 (TLS).
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# Куда слать письма о заказах. Если не задан — email не отправляется.
NOTIFICATION_EMAIL=""

# ─── Публичные ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_YANDEX_METRIKA_ID=""
